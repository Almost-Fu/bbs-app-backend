# =============================================================================
# 环境变量模板
#   本地开发：复制本文件为 .env，按需改地址/密码即可
#   生产部署：这些变量填进 Render 的 Environment Variables（不要把 .env 提交到 Git）
# =============================================================================

# ---- 运行环境：development 本地 / production 云端（Render）----
APP_ENV=development
# 端口：本地默认 8000；Render 会自动注入 PORT，不需要手填
# PORT=8000

# ---- MySQL：本地是 127.0.0.1；线上换成 Aiven 控制台给的连接信息 ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=你的MySQL密码
DB_NAME=bbs_app
DB_POOL_SIZE=5
# DB_WAIT_TIMEOUT=10

# ---- SSL：Aiven 强制要求 TLS；本地 MySQL 一般没有证书，保持 false ----
DB_SSL=false
# 线上（Render）改成：
# DB_SSL=true
# 有证书文件时填路径：
# DB_SSL_CA=./aiven-ca.pem
# Render 上没有文件系统，直接把 Aiven 下载的 ca.pem 全文粘到下面这个变量里（支持 \n 单行写法）：
# DB_SSL_CA_PEM=-----BEGIN CERTIFICATE-----\nMIID...\n-----END CERTIFICATE-----

# ---- 远程库连接重试：Aiven 首连慢、维护重启、网络抖动时有用 ----
DB_CONNECT_TIMEOUT=10
DB_CONNECT_RETRIES=3
DB_CONNECT_RETRY_DELAY=1.5

# ---- JWT ----
# 至少 32 个字符（SHA256 的 HMAC 密钥推荐长度，过短 PyJWT 会告警）
# 生成方式：python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRE_HOURS=168

# ---- CORS 白名单：逗号分隔的前端域名（H5 网页版 + 管理后台）----
# 留空 = 允许所有来源（本地开发方便）；线上务必填自己的 Vercel 域名
# CORS_ORIGINS=https://bbs-app-h5.vercel.app,https://bbs-admin-web.vercel.app

# ---- 上传 ----
MAX_IMAGE_MB=5
# 图片存放目录。Render 默认磁盘是临时的（重新部署即丢图）：
# 需要长期保存就在 Render 挂 Persistent Disk（挂载点例如 /var/data），然后设置
# UPLOAD_DIR=/var/data/uploads

